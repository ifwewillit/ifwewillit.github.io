    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "~5.9",
    "vite": "^7.3.6"
  }
}
